# Backend API Configuration (copy to .env.local for development)

# API Base URL
# Development: http://localhost:8000
# Production: https://api.your-domain.com
VITE_API_URL=http://localhost:8000

# API Version (don't change unless API version changes)
VITE_API_VERSION=/api/v1

# WebSocket Configuration
# Set to true to enable real-time streaming predictions
VITE_WEBSOCKET_ENABLED=true

# WebSocket heartbeat interval (milliseconds)
VITE_WEBSOCKET_HEARTBEAT_INTERVAL=30000

# Development/Debug Settings
VITE_DEBUG=false
VITE_LOG_PREDICTIONS=true

# Feature Flags
VITE_FEATURE_TEXT_TO_SIGN=true
VITE_FEATURE_DICTIONARY=true
VITE_FEATURE_GEMINI_INTEGRATION=true
