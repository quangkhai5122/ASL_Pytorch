# ==============================================================================
# ENVIRONMENT CONFIGURATION - Copy to .env and fill in your values
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=your-secret-key-change-in-production-min-32-chars-random
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ==============================================================================
# MODEL CONFIGURATION
# ==============================================================================
MODEL_PATH=./models/model_best_full_training.pth
DEVICE=auto  # Options: auto (GPU if available, else CPU), cuda, cpu
NUM_CLASSES=250
INPUT_SIZE=64
N_ROWS=543
N_DIMS=3

# Model inference parameters
WINDOW_SIZE=32
MIN_FRAMES_FOR_INFER=8
INFER_STRIDE_FRAMES=4
CONFIDENCE_ON=0.25
CONFIDENCE_OFF=0.12
CONFIDENCE_UNKNOWN=0.08
STABILITY_N=3
PROB_EMA_ALPHA=0.55
MOVEMENT_THRESHOLD=0.003
MIN_HAND_POINTS=4

# ==============================================================================
# GEMINI API CONFIGURATION (Optional)
# ==============================================================================
ENABLE_GEMINI=true
GEMINI_API_KEY=your-google-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# ==============================================================================
# AWS S3 CONFIGURATION (Optional - for video storage)
# ==============================================================================
USE_S3=false
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
S3_BUCKET_NAME=signlanguage-videos

# ==============================================================================
# CORS & FRONTEND CONFIGURATION
# ==============================================================================
CORS_ORIGINS=["https://signlanguagetrans.lovable.app", "http://localhost:3000", "http://localhost:5173"]
ALLOWED_HOSTS=["localhost", "127.0.0.1", "*.example.com"]

# ==============================================================================
# DATABASE CONFIGURATION (SQLite for MVP, PostgreSQL for production)
# ==============================================================================
DATABASE_URL=sqlite:///./gislr.db
DATABASE_ECHO=false  # Set to true to see SQL queries in logs

# ==============================================================================
# LOGGING CONFIGURATION
# ==============================================================================
LOG_LEVEL=INFO  # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT=json  # Options: json, text

# ==============================================================================
# SERVER CONFIGURATION
# ==============================================================================
WORKERS=4
HOST=0.0.0.0
PORT=8000
RELOAD=false  # Set to true for development (auto-reload on code changes)

# ==============================================================================
# RATE LIMITING (Optional)
# ==============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# ==============================================================================
# VIDEO PROCESSING CONFIGURATION
# ==============================================================================
MAX_VIDEO_FILE_SIZE_MB=500
SUPPORTED_VIDEO_FORMATS=["mp4", "avi", "mov", "flv", "wmv"]
VIDEO_FRAME_RATE=30
MAX_VIDEO_DURATION_SECONDS=300

# ==============================================================================
# SOCKETIO / WEBSOCKET CONFIGURATION
# ==============================================================================
WEBSOCKET_PING_INTERVAL=25
WEBSOCKET_PING_TIMEOUT=10

# ==============================================================================
# CACHE CONFIGURATION (Optional)
# ==============================================================================
ENABLE_REDIS_CACHE=false
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=3600
